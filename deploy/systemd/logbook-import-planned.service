[Unit]
Description=Auto-import planned SkedPlus pairings into the logbook
# Started by logbook-import-planned.path when inbox/planned is non-empty.
# Safety: if something loops, stop retriggering rather than spinning.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=oneshot
User=crushbox
Group=crushbox
WorkingDirectory=/home/crushbox/Developer/logbook
ExecStart=/home/crushbox/Developer/logbook/scripts/process-inbox.sh planned
Nice=10
TimeoutStartSec=15min
