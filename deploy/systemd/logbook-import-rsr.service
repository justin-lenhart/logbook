[Unit]
Description=Auto-import SkyWest RSR report PDFs into RSR_Metrics
# Started by logbook-import-rsr.path when inbox/rsr is non-empty.
# Safety: if something loops, stop retriggering rather than spinning.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=oneshot
User=crushbox
Group=crushbox
WorkingDirectory=/home/crushbox/Developer/logbook
ExecStart=/home/crushbox/Developer/logbook/scripts/process-inbox.sh rsr
Nice=10
TimeoutStartSec=15min
